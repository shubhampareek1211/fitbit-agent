# Keep secrets, raw exports and local tooling out of the build context.
client_secret*.json
credentials.json
*.pem
.env
.env.*
data/raw/
logs/
*.log
.git/
.venv/
__pycache__/
.pytest_cache/
.DS_Store

# Daily snapshots live in Cloud Storage; only the eval snapshot is committed (it is also the offline fallback).
data/snapshots/*
!data/snapshots/2026-11-07/
